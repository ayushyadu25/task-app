PORT=5000
# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# MongoDB Atlas:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/taskflow?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# For production, set this to your deployed frontend URL.
# Local development allows localhost/127.0.0.1 on any port automatically.
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Optional. The app works without this key by returning a local fallback estimate.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
